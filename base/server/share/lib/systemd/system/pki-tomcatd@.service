[Unit]
Description=PKI Tomcat Server %i
PartOf=pki-tomcatd.target

[Service]
Type=simple
EnvironmentFile=/usr/share/pki/etc/tomcat.conf
EnvironmentFile=/etc/tomcat/tomcat.conf
Environment="NAME=%i"
EnvironmentFile=-/etc/sysconfig/%i
EnvironmentFile=/usr/share/pki/etc/pki.conf
EnvironmentFile=/etc/pki/pki.conf

# Required environment variables for Tomcat
Environment="CATALINA_HOME=/usr/share/tomcat"
Environment="CATALINA_BASE=/var/lib/pki/%i"
Environment="CATALINA_TMPDIR=/var/lib/pki/%i/temp"

ExecStartPre="${SBIN_INSTALL_DIR}/pki-server" upgrade %i
ExecStartPre="${SBIN_INSTALL_DIR}/pki-server" migrate %i
ExecStartPre="${BIN_INSTALL_DIR}/pkidaemon" start %i

# Use abstraction wrappers - work for both old and new Tomcat
ExecStart="${SBIN_INSTALL_DIR}/pki-tomcat-start"
ExecStop="${SBIN_INSTALL_DIR}/pki-tomcat-stop"

SuccessExitStatus=143
Restart=on-failure
User=pkiuser
Group=pkiuser

[Install]
WantedBy=pki-tomcatd.target
